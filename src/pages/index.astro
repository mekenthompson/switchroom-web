---
import Base from '../layouts/Base.astro';
import StorylineHero from '../components/StorylineHero.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import LinearIssue from '../components/LinearIssue.astro';
import BoxesTerm from '../components/BoxesTerm.astro';
import VaultTerm from '../components/VaultTerm.astro';
import PlansCard from '../components/PlansCard.astro';
import { REPO, DOCS, OVERLAY_EXAMPLE, LICENSE, HERMES } from '../site';
---

<Base>
  <header class="nav">
    <div class="container nav-row">
      <a class="brand" href="/">
        <img src="/assets/switchroom-mark-64.png" alt="" width="30" height="30" />
        Switchroom
      </a>
      <nav class="nav-links" aria-label="Site">
        <a class="anchor" href="#proofs">Proofs</a>
        <a class="anchor" href="#how">How it works</a>
        <a class="anchor" href="#next">Shipping next</a>
        <a class="anchor" href="#start">Early access</a>
        <a class="nav-cta" href={REPO}><span aria-hidden="true">★</span> GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ Hero ============ -->
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span> <span>An opinionated <a href={HERMES}>Hermes Agent</a> distribution · open source · early access</span></p>
          <h1 class="hero-title display">Hermes agents that work your projects, <span class="brass nowrap-block">not just your chats.</span></h1>
          <p class="hero-kicker">One box per agent. Linear holds the thread. Tuned for the Claude plan you already pay for.</p>
          <p class="lede hero-sub">
            Switchroom packages <a href={HERMES}>Hermes Agent</a> by Nous Research for a
            team of specialists. Each one can pick up issues and report back where you
            already track the work, and none of them can reach into the others. Same
            Hermes skills, memory and tools underneath.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href={REPO}><span aria-hidden="true">★</span> Star on GitHub</a>
            <a class="btn btn-secondary" href="#proofs">See the proofs</a>
          </div>
          <p class="hero-note">Claude-first, not Claude-only · Codex, Grok, OpenRouter and local models too</p>
        </div>
        <div class="hero-stage">
          <StorylineHero />
          <p class="hero-demo-cap">
            Chat is standard Hermes: Telegram on the run, Slack or Hermes Desktop at your
            desk, and Linear keeps you from losing the thread as you jump between issues,
            projects and agents.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ Four proofs ============ -->
    <section class="section alt" id="proofs">
      <div class="container">
        <div class="section-head">
          <p class="kicker">Four proofs</p>
          <h2 class="section-title">Less chatbot, more colleague with a ticket.</h2>
          <p class="lede">
            Each claim below traces to the <a href={REPO}>public repo</a>. Mockups are
            illustrative, with made-up workspaces, people and data.
          </p>
        </div>

        <div class="proofs">
          <article class="proof-row proof-wide reveal">
            <div class="proof-copy">
              <span class="tag">01 · linear</span>
              <h3>Works your projects</h3>
              <p>
                Hand an issue to an agent in Linear and it gets an owning agent and a
                durable task. Checkpoints land as ordinary issue comments. A follow-up
                from any chat reaches that same task, not a fresh one.
              </p>
              <p>
                Several agents can work one project, and one can take over another's issue
                without both of them running it. You keep the assignee, the board and the
                comment thread you already read as a dev or a PM.
              </p>
              <p class="proof-fine">The Linear plugin is included and stays off until your overlay turns it on.</p>
            </div>
            <figure class="proof-shot">
              <LinearIssue />
              <figcaption>Illustrative: you stay the assignee, the agent is the delegate.</figcaption>
            </figure>
          </article>

          <article class="proof-row reveal">
            <div class="proof-copy">
              <span class="tag">02 · own-box</span>
              <h3>Safe to leave running</h3>
              <p>
                One container, gateway, volume and network per agent. No Docker socket, no
                host network, no privileged mode. Each agent gets its own vault credentials
                at runtime, and 1Password Connect is the default we ship.
              </p>
              <p>
                Agents are isolated by default: one can't see another's files, network or
                vault. Agent-to-agent messaging is an opt-in you wire up, and a peer's text
                arrives as untrusted input, never as permission.
              </p>
            </div>
            <figure class="proof-shot">
              <BoxesTerm />
            </figure>
          </article>

          <article class="proof-row reveal">
            <div class="proof-copy">
              <span class="tag">03 · claude-first</span>
              <h3>Tuned for your Claude plan</h3>
              <p>
                Claude-first, not Claude-only. Claude Subscription DirectSDK drives the
                official Claude Code CLI on the agent's own login, with no API-key fallback.
                Claude ACP brings your claude.ai connectors to the agent as tools. Codex,
                Grok, OpenRouter and local models work too, picked per agent.
              </p>
              <p class="proof-fine">
                The fine print: DirectSDK is Nous Research's plugin, included unmodified and
                labelled experimental by its author. Connectors are qualified for reads only
                so far, and every connector call uses extra inference from the same plan.
                All of it is included and off until you enable it. Switchroom isn't made,
                endorsed or approved by Anthropic.
              </p>
            </div>
            <figure class="proof-shot proof-narrow">
              <PlansCard />
            </figure>
          </article>

          <article class="proof-row reveal">
            <div class="proof-copy">
              <span class="tag">04 · digest-pinned</span>
              <h3>Runs like infrastructure</h3>
              <p>
                The image is a provenance-checked child of an exact Hermes Agent image, and
                you run it by <code>sha256</code> digest, not a tag that moves under you.
                Identity, compose and secret bindings stay in your private overlay repo,
                never in the image.
              </p>
              <p>
                Plugins are mounted per agent, not baked in. Leave one unmounted and it's
                simply absent, with no baked copy to fall back to.
              </p>
            </div>
            <figure class="proof-shot">
              <VaultTerm />
            </figure>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ How it works ============ -->
    <section class="section" id="how">
      <div class="container">
        <div class="section-head">
          <p class="kicker">How it works</p>
          <h2 class="section-title">One image. One container per agent. Nothing shared.</h2>
          <p class="lede">
            Out of the box, Hermes runs several profiles from one install, and upstream
            now folds them into one shared gateway. That's a fine default for one person and the wrong blast
            radius for a team. Switchroom keeps one container and one gateway per agent
            on purpose, and keeps everything that identifies you out of the image.
          </p>
        </div>
        <ArchDiagram />
        <p class="arch-cap">Left: what you pull. Middle: what runs, one box per agent. Right: what stays yours.</p>
        <div class="beats beats-text">
          <div class="beat reveal">
            <span class="beat-num">01</span>
            <h3>Name your specialists</h3>
            <p>
              One agent per job: a chief of staff, a marketer, a coach, an ops engineer.
              Each is a compose service with its own volume, network and workspace. Adding
              one is adding a service.
            </p>
          </div>
          <div class="beat reveal">
            <span class="beat-num">02</span>
            <h3>Keep you in the overlay</h3>
            <p>
              Your private overlay repo holds the config, the compose file and the secret
              bindings. The public image holds none of it, and you pin it by digest, not
              by a tag that moves under you.
            </p>
          </div>
          <div class="beat reveal">
            <span class="beat-num">03</span>
            <h3>Turn on what each agent needs</h3>
            <p>
              Linear, Claude ACP, browser handoff and Kokoro voice are included and
              disabled until the overlay enables them per agent. Enabling one without its
              policy fails closed.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Included vs shipping next ============ -->
    <section class="section alt" id="next">
      <div class="container">
        <div class="section-head">
          <p class="kicker">Today and next</p>
          <h2 class="section-title">What's in the box, and what isn't yet</h2>
          <p class="lede">
            Built, published and deployed are different claims. So are included and
            switched on. Here's the honest split.
          </p>
        </div>
        <div class="adds">
          <div class="adds-col">
            <p class="adds-k">Included today, off until you turn it on</p>
            <ul>
              <li><b>Linear plugin.</b> Issues, delegates, checkpoints and takeovers.</li>
              <li><b>Claude ACP and Claude account connectors.</b> Plan login and claude.ai connectors as tools, reads qualified.</li>
              <li><b>Claude Subscription DirectSDK.</b> Nous Research's plugin, experimental.</li>
              <li><b>Browser handoff.</b> An isolated browser the agent can hand to you for a login.</li>
              <li><b>Kokoro voice.</b> Local text to speech through a sidecar.</li>
            </ul>
          </div>
          <div class="adds-col brass next-col">
            <p class="adds-k"><span class="next-badge">Shipping next</span> Not published yet</p>
            <ul>
              <li><b>A starter overlay that switches everything on.</b> Opt out, not opt in.</li>
              <li><b>Honcho memory and local voice, wired in.</b> No assembly required.</li>
              <li><b>The config renderer.</b> Shared defaults, roles and per-agent overrides, rendered for you.</li>
              <li><b>The rollout runner.</b> Image updates across agents, with auto-rollback.</li>
              <li><b>Backups and monitors.</b> So leaving it running is the boring part.</li>
            </ul>
            <p class="next-note">None of this is available today. The repo will say so first when it is.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Early access ============ -->
    <section class="section" id="start">
      <div class="container">
        <div class="install-grid">
          <div class="install-copy">
            <p class="kicker">Early access</p>
            <h2 class="section-title">Bring a Linux box and an opinion</h2>
            <p style="margin-top:14px">
              Honest version: this isn't a five-minute install yet. Today Switchroom is a
              working pattern you run from your own private overlay repo. A guided
              quickstart is the next milestone.
            </p>
            <h3>What you need</h3>
            <ul class="needs">
              <li>A Linux box with Docker: a cheap VPS or the machine under your desk</li>
              <li>A private git repo for your overlay</li>
              <li>A vault (1Password Connect is the default we ship)</li>
              <li>The model plans or keys you want each agent on</li>
              <li>A Linear workspace, if you want agents on your issues</li>
              <li>A bot token per agent for each chat app you use</li>
            </ul>
            <div class="install-ctas">
              <a class="btn btn-primary" href={REPO}><span aria-hidden="true">★</span> Star on GitHub</a>
              <a class="btn btn-secondary" href={DOCS}>Read the docs</a>
            </div>
          </div>
          <div class="term reveal">
            <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>you@your-box</span></div>
            <pre><code><span class="c"># get the pattern</span>
<span class="p">$</span> git clone \
    {REPO}
<span class="p">$</span> cp -r hermes-fleet/examples/overlay-repo \
    ~/my-switchroom

<span class="c"># one service per agent;</span>
<span class="c"># secrets at runtime, never in git</span>
<span class="p">$</span> cd ~/my-switchroom
<span class="p">$</span> export HERMES_FLEET_IMAGE='…@sha256:&lt;digest&gt;'
<span class="p">$</span> docker compose config</code></pre>
          </div>
        </div>
        <p class="surfaces-note">Start with the <a href={OVERLAY_EXAMPLE}>example overlay</a>. Every profile in it is synthetic.</p>
      </div>
    </section>
  </main>

  <!-- ============ Footer ============ -->
  <footer class="footer">
    <div class="container">
      <div class="footer-row">
        <a class="brand" href="/">
          <img src="/assets/switchroom-mark-64.png" alt="" width="30" height="30" loading="lazy" />
          Switchroom
        </a>
        <nav class="footer-links" aria-label="Footer">
          <a href={REPO}>GitHub</a>
          <a href={DOCS}>Docs</a>
          <a href={HERMES}>Hermes Agent</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Use</a>
          <a href={LICENSE}>MIT License</a>
        </nav>
      </div>
      <p class="footnote">
        Switchroom is an opinionated distribution of Hermes Agent by Nous Research: one
        container per agent, secrets from a vault, Linear for the thread, the model plans
        you choose. Not affiliated with Nous Research or Anthropic. Self-hosted on your own
        machine. Open source. Early access. Chat and Linear mockups on this page are
        illustrative.
      </p>
    </div>
  </footer>
</Base>
