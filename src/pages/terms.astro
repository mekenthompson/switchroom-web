---
import Base from '../layouts/Base.astro';

const repo = 'https://github.com/switchroom/switchroom';
---

<Base>
  <header class="nav">
    <div class="container nav-row">
      <a class="brand" href="/">
        <img src="/assets/switchroom-mark-64.png" alt="" width="30" height="30" />
        Switchroom
      </a>
      <nav class="nav-links" aria-label="Site">
        <a class="nav-cta" href={repo}><span aria-hidden="true">★</span> GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main" class="legal-page">
    <article class="container legal-content">
      <p class="kicker">Switchroom</p>
      <h1 class="display">Terms of Use</h1>
      <p>Switchroom provides access to a managed deployment of AI agents and connected tools. Use it only with accounts, information and systems you are entitled to access. Google connections are optional and require the account owner's consent.</p>
      <p>You remain responsible for your instructions, permissions and reviewing consequential actions and AI-generated output. Agents can make mistakes; do not rely on their output as professional advice or as a substitute for checking important information.</p>
      <p>Features, availability and configured integrations may change. We may restrict access to protect users, systems or legal obligations. You may stop using the service and revoke connected-account access at any time. Nothing in these terms excludes rights or protections that cannot lawfully be excluded.</p>
      <p>Our <a href="/privacy">Privacy Policy</a> explains data processing and deletion requests. Contact <a href="mailto:info@switchroom.ai">info@switchroom.ai</a>.</p>
    </article>
  </main>

  <footer class="footer">
    <div class="container">
      <nav class="footer-links" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
      </nav>
    </div>
  </footer>
</Base>
