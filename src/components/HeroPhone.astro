---
// Hero: a Telegram chat with `clerk`, the canonical specialist.
// Pure HTML/CSS mockup — messages animate in via CSS (reduced-motion safe).
---

<div
  class="phone tg"
  role="img"
  aria-label="Telegram chat with clerk, a Switchroom assistant. You ask how tomorrow looks and to fit the dentist in. Clerk replies that the morning has three meetings and the afternoon is clear, offers a 2:30 slot at Dr Chen, then posts an approval card asking permission to email the practice, with Approve and Deny buttons."
>
  <div class="phone-screen">
    <div class="phone-status" aria-hidden="true">
      <span>9:41</span>
      <span class="pills"><i class="pill sig"></i><i class="pill"></i></span>
    </div>
    <div class="tg-head" aria-hidden="true">
      <span class="back">‹</span>
      <span class="tg-ava a1">c</span>
      <span class="who"><b>clerk</b><span>bot</span></span>
      <span class="dots">⋮</span>
    </div>
    <div class="tg-body" aria-hidden="true">
      <span class="tg-pill">Today</span>
      <div class="msg out">
        <p>clerk, how's tomorrow looking? and see if the dentist can fit me in</p>
        <span class="meta">9:41 <span class="ticks">✓✓</span></span>
      </div>
      <div class="msg in">
        <span class="name">clerk</span>
        <p><b>Three meetings, all before noon.</b> Clear after 1pm.</p>
        <ul>
          <li>9:00 standup</li>
          <li>10:30 board prep with Lisa</li>
          <li>11:30 1:1 with Sam</li>
        </ul>
        <p>Dr Chen has 2:30 or 4:00 open. 2:30 keeps your evening free.</p>
        <span class="meta">9:41</span>
      </div>
      <div class="msg in">
        <span class="name">clerk</span>
        <p class="card-title">🔐 Approval needed</p>
        <p>Email Dr Chen's front desk to book <b>Thu 2:30pm</b>?</p>
        <div class="tg-kb">
          <span class="kb-btn">✅ Approve</span>
          <span class="kb-btn">🚫 Deny</span>
        </div>
        <span class="meta">9:42</span>
      </div>
    </div>
  </div>
</div>
