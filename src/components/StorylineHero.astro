---
// StorylineHero — "A day on the switchboard", the hero demo.
//
// A ~60s loopable, silent, pure-CSS animation of one ship-day arc at Acme
// Robotics, played inside the Telegram phone frame: fleet list → ask klanker →
// live progress card editing in place → approval card + tap → rich native
// reply → /usage quota card → notification-banner hop to marko → back-chevron
// to the chat list → row-tap back into klanker → loop seam.
//
// Product truths modeled:
//   - no token streaming: header shows typing…/working…, then the WHOLE bubble
//     pops in at once
//   - progress cards edit in place (rows flip, bar grows) — no new bubbles
//   - approval resolves by the card editing itself; button row collapses
//   - pinned card lives in the pin bar under the header
//
// Implementation: every animated element carries ONE full-loop animation
// (duration = var(--sl-loop), infinite). Scene timing lives in the keyframe
// percentages; the master duration is the single knob. Percent = seconds/76*100.
// NB: the second values in the table below are the ORIGINAL 76s design
// reference used to derive the percentages. --sl-loop is now 60s, so real
// wall-clock times are ×(60/76); the percentages (the actual choreography)
// are unchanged.
//
// ── Timing table (seconds → % · derived at the 76s design reference) ───────
//  Scene 1  fleet list           0.0–4.4    (badge pulse 2.0=2.63%, row tap 3.6=4.74%, push 4.0–4.4=5.26–5.79%)
//  Scene 2  the ask              4.4–14     (out msg 5.5=7.24%, ✓✓ 6.3=8.29%, typing 7.5–10=9.87–13.16%, reply 10=13.16%)
//  Scene 3  progress card        14–30      (card 14=18.42%, edits 18=23.68% / 22.5=29.61% / 27=35.53%)
//  Scene 4  approval             30–37.5    (card 30=39.47%, tap 34=44.74%, resolve 34.6=45.53%, pin swap 36.5=48.03%)
//  Scene 5  rich reply           37.5–46.5  (typing 37.5=49.34%, bubble 39.2=51.58%, hold to 46.5)
//  Scene 6  banner hop to marko  46.5–56.5  (banner 46.5=61.18%, tap 48.8=64.21%, push 49.2–49.6=64.74–65.26%,
//                                            "go" 51.5=67.76%, typing 52.6–53.8, confirm 53.8=70.79%)
//  Scene 7  back → chat list →   56.5–60.1  (back tap 56.5=74.34%, pop 56.9–57.3=74.87–75.39%, row tap 59.3=78.03%,
//           row-tap into klanker              push 59.7–60.1=78.55–79.08%)
//  Scene 8  /usage quota card    60.1–71.5  (out 61.2=80.53%, typing 62–64=81.58–84.21%, card 64=84.21%, hold)
//  Scene 9  loop seam            73.5–76    (chat list state A fades over 73.5–75.5=96.71–99.34%)
// ───────────────────────────────────────────────────────────────────────────
//
// Reduced motion: zero animation — the phone shows a static final-state frame
// (rich reply tail + /usage quota card, approval resolved, progress done).
const { class: className = '' } = Astro.props;
---

<div
  class={`phone tg sl-phone ${className}`.trim()}
  role="img"
  aria-label="Animated Telegram demo of one Switchroom ship day. A chat list shows five named assistants: clerk, marko, coach, quill and klanker. You open klanker and ask it to refresh the Acme landing page before launch. klanker dispatches a worker and pins a live progress card that updates itself: repo cloned, hero copy applied, Lighthouse 99 mobile, PR 41 open. It then stops and asks approval to push to acme-site main, which deploys on merge. You tap Approve, the card resolves, and one rich reply lands: a status table, a config diff, an expandable deploy log. You send slash-usage and get a plan-quota card: 41 percent of the 5-hour window used, zero API spend. A notification from marko drops in — the launch email is queued — you hop over, say go, marko locks the 9am send, and you return to the chat list with updated previews. The loop restarts."
>
  <div class="phone-screen sl-stage">
    <div class="phone-status" aria-hidden="true">
      <span>16:04</span>
      <span class="pills">
        <span class="sig"><i></i><i></i><i></i><i></i></span>
        <span class="wifi"><svg width="16" height="11" viewBox="0 0 16 11" fill="none" aria-hidden="true"><circle cx="8" cy="9.3" r="1.3" fill="currentColor"/><path d="M5.2 7.3a4.2 4.2 0 0 1 5.6 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M3 4.9a7.4 7.4 0 0 1 10 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M.9 2.5a10.6 10.6 0 0 1 14.2 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
        <span class="batt"></span>
      </span>
    </div>

    <div class="sl-viewport" aria-hidden="true">
      <!-- ══ Screen 1 · chat list (the fleet) ══ -->
      <section class="sl-screen sl-list">
        <div class="tg-head list-head">
          <span class="edit">Edit</span>
          <span class="who"><b>Chats</b></span>
          <span class="compose">✎</span>
        </div>
        <div class="tg-list">
          <div class="chat">
            <span class="tg-ava a1">c</span>
            <div class="cbody">
              <div class="l1"><b>clerk</b><time>14:20</time></div>
              <div class="l2"><span>Booked. Thu 2:30 with Dr Chen — invite sent.</span></div>
            </div>
          </div>
          <div class="chat">
            <span class="tg-ava a2">m</span>
            <div class="cbody">
              <div class="l1"><b>marko</b>
                <span class="sl-swap sl-time"><time class="vA">9:15</time><time class="vB">16:05</time></span>
              </div>
              <div class="l2">
                <span class="sl-swap sl-prev">
                  <span class="vA">Three hooks drafted — the second one's the keeper</span>
                  <span class="vB">Locked. ✅ 9:00 send, list of 1,240 — I'll…</span>
                </span>
              </div>
            </div>
          </div>
          <div class="chat">
            <span class="tg-ava a3">co</span>
            <div class="cbody">
              <div class="l1"><b>coach</b><time>7:02</time></div>
              <div class="l2"><span>Morning. Sleep score 84 — good night for intervals</span></div>
            </div>
          </div>
          <div class="chat">
            <span class="tg-ava a5">q</span>
            <div class="cbody">
              <div class="l1"><b>quill</b><time>Yesterday</time></div>
              <div class="l2"><span class="muted-check">✓✓</span><span>Second draft attached — tightened the opening</span></div>
            </div>
          </div>
          <div class="chat sl-row-k">
            <span class="sl-ripple sl-rip-row"></span>
            <span class="tg-ava a4">k</span>
            <div class="cbody">
              <div class="l1"><b>klanker</b>
                <span class="sl-swap sl-time"><time class="vA">15:52</time><time class="vB">16:04</time></span>
              </div>
              <div class="l2">
                <span class="sl-swap sl-prev">
                  <span class="vA">Fleet healthy. All 5 agents up, backups clean.</span>
                  <span class="vB">✅ Acme landing page shipped — Lighthouse 99</span>
                </span>
                <span class="badge sl-badge">1</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ Screen 2 · klanker chat (the main arc) ══ -->
      <section class="sl-screen sl-k">
        <div class="sl-khead">
          <div class="tg-head">
            <span class="back">‹</span>
            <span class="who"><b>klanker</b>
              <span class="sl-sub">
                <span class="s-bot">bot</span>
                <span class="s-typ">typing…</span>
                <span class="s-wrk">working…</span>
              </span>
            </span>
            <span class="tg-ava a4">k</span>
          </div>
          <div class="tg-pinbar sl-pinbar">
            <span class="pin-rail"></span>
            <span class="pin-lines">
              <span class="pin-label">📌 Pinned message</span>
              <span class="sl-swap sl-pinprev">
                <span class="pin-preview vA">⚙️ worker · refresh the Acme landing page</span>
                <span class="pin-preview vB">✅ worker · Acme landing page — shipped</span>
              </span>
            </span>
            <span class="pin-x">✕</span>
          </div>
        </div>
        <div class="sl-bodyw">
          <div class="sl-scroll">
            <span class="tg-pill">Today</span>

            <div class="msg out tail sl-m1">
              <p>klanker, refresh the Acme landing page before tomorrow's launch — new hero copy is in marko's doc</p>
              <span class="meta">15:58 <span class="sl-swap sl-tick1"><span class="ticks vA">✓</span><span class="ticks vB">✓✓</span></span></span>
            </div>

            <div class="msg in tail sl-m2">
              <span class="name">klanker</span>
              <p>On it. Dispatching <b>@worker</b> on a branch — I'll pin progress here so you can watch.</p>
              <span class="meta">15:58</span>
            </div>

            <!-- the progress card: ONE bubble that edits in place -->
            <div class="mgroup in wide sl-prog">
              <div class="msg in tail sl-flash sl-flash-prog">
                <span class="name">klanker</span>
                <p class="card-title">⚙️ worker · refresh the Acme landing page</p>
                <div class="rows">
                  <span class="sl-swap sl-r1">
                    <span class="row vA"><span class="st dim">·</span><span class="dim">Clone repo, cut branch</span></span>
                    <span class="row vB"><span class="st ok">✓</span><span>Repo cloned, branch cut</span></span>
                  </span>
                  <span class="sl-swap sl-r2">
                    <span class="row vA"><span class="st dim">·</span><span class="dim">Apply marko's hero copy</span></span>
                    <span class="row vB"><span class="st run">▸</span><span>Applying marko's hero copy</span></span>
                    <span class="row vC"><span class="st ok">✓</span><span>Hero copy applied, build green</span></span>
                  </span>
                  <span class="sl-swap sl-r3">
                    <span class="row vA"><span class="st dim">·</span><span class="dim">Build + Lighthouse, mobile pass</span></span>
                    <span class="row vB"><span class="st run">▸</span><span>Running Lighthouse, mobile pass</span></span>
                    <span class="row vC"><span class="st ok">✓</span><span>Lighthouse 99 mobile, 100 desktop</span></span>
                  </span>
                  <span class="sl-swap sl-r4">
                    <span class="row vA"><span class="st dim">·</span><span class="dim">Open PR for review</span></span>
                    <span class="row vB"><span class="st ok">✓</span><span>PR #41 open</span></span>
                  </span>
                </div>
                <span class="bar"><i class="sl-bar"></i></span>
                <span class="meta">
                  <span class="sl-swap sl-pmeta">
                    <span class="vA">updated just now</span>
                    <span class="vB">updated 3s ago</span>
                    <span class="vC">updated 2s ago</span>
                    <span class="vD">done in 2m 04s</span>
                  </span>
                </span>
              </div>
            </div>

            <!-- the approval card: the leash -->
            <div class="mgroup in wide sl-appr">
              <div class="msg in tail sl-flash sl-flash-appr">
                <span class="name">klanker</span>
                <span class="sl-swap sl-atitle">
                  <p class="card-title vA">🔐 Approval needed</p>
                  <p class="card-title vB">✅ Approved · by you, 16:04</p>
                </span>
                <p>Push 1 commit to <code>acme-site:main</code> — deploys on merge.</p>
                <p><b>Scope:</b> this push only · expires in 1h</p>
                <span class="meta">16:03</span>
              </div>
              <div class="sl-kb">
                <div class="tg-kb">
                  <span class="kb-btn sl-btn-ok"><span class="sl-ripple sl-rip-ok"></span>✅ Approve</span>
                  <span class="kb-btn">🚫 Deny</span>
                </div>
              </div>
            </div>

            <!-- the payoff: one rich native reply -->
            <div class="msg in tail sl-rich" style="max-width:94%; width:94%">
              <span class="name">klanker</span>
              <p><b>Live.</b> Deployed clean in 3m 41s.</p>
              <table>
                <thead><tr><th>page</th><th>status</th><th>LCP</th></tr></thead>
                <tbody>
                  <tr><td>home</td><td>✅ live</td><td>1.2s</td></tr>
                  <tr><td>pricing</td><td>✅ live</td><td>1.1s</td></tr>
                </tbody>
              </table>
              <p>One config change shipped with it:</p>
              <pre><span class="k">- hero: "Meet your agents"</span>
<span class="s">+ hero: "Your subscription is a team now."</span></pre>
              <div class="quote">
                <b>Full deploy log</b> — 178 lines · rollout 3m 41s end to end…
                <span class="expander">▼ expand</span>
              </div>
              <span class="meta">16:04</span>
            </div>

            <!-- subscription-honest: /usage -->
            <div class="msg out tail sl-m3">
              <p>/usage</p>
              <span class="meta">16:05 <span class="sl-swap sl-tick2"><span class="ticks vA">✓</span><span class="ticks vB">✓✓</span></span></span>
            </div>

            <div class="msg in tail sl-quota" style="max-width:92%">
              <span class="name">klanker</span>
              <p class="card-title">📊 Plan quota</p>
              <div class="rows">
                <span class="row"><span class="st ok">✓</span><span>5h window: <b>41% used</b>, resets 6:12pm</span></span>
                <span class="row"><span class="st ok">✓</span><span>Week: on track — heaviest day Tuesday</span></span>
                <span class="row"><span class="st ok">✓</span><span>API spend: <b>$0</b> — same bill as yesterday</span></span>
              </div>
              <span class="meta">16:05</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ Screen 3 · marko chat (the hop) ══ -->
      <section class="sl-screen sl-m">
        <div class="tg-head">
          <span class="back sl-back"><span class="sl-ripple sl-rip-back"></span>‹</span>
          <span class="who"><b>marko</b>
            <span class="sl-sub">
              <span class="s-bot">bot</span>
              <span class="s-typ">typing…</span>
            </span>
          </span>
          <span class="tg-ava a2">m</span>
        </div>
        <div class="tg-body">
          <span class="tg-pill">Today</span>
          <div class="msg in tail" style="max-width:92%">
            <span class="name">marko</span>
            <p>Landing page is live — nice work next door. Launch email is queued for <b>9:00 tomorrow</b>, subject: "Your subscription is a team now." Say go and it's locked.</p>
            <span class="meta">16:04</span>
          </div>
          <div class="msg out tail sl-go">
            <p>go</p>
            <span class="meta">16:05 <span class="sl-swap sl-tick3"><span class="ticks vA">✓</span><span class="ticks vB">✓✓</span></span></span>
          </div>
          <div class="msg in tail sl-lock">
            <span class="name">marko</span>
            <p>Locked. ✅ 9:00 send, list of 1,240 — I'll report open rates by lunch.</p>
            <span class="meta">16:05</span>
          </div>
        </div>
      </section>

      <!-- ══ In-app notification banner (marko) ══ -->
      <div class="sl-banner">
        <span class="sl-ripple sl-rip-ban"></span>
        <span class="tg-ava a2">m</span>
        <span class="sl-ban-txt"><b>marko</b><span>Page is live — launch email queued for 9:00. Say go.</span></span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════════
     Storyline hero — layout + STATIC final-state frame (reduced-motion view).
     All motion lives in the media block at the bottom.
     ════════════════════════════════════════════════════════════════════════ */

  .sl-phone {
    /* master loop duration — the one knob. Keyframe % map in the component header.
       Tightened 76s → 60s for a snappier, more engaging hero (all keyframes are
       percentage-anchored, so the choreography proportions are unchanged). */
    --sl-loop: 60s;
    /* auto-scroll stops for the klanker chat (tuned against rendered heights
       at the 340px frame width; verified by the capture run) */
    --sl-s1: -12px;   /* progress card fully visible   (t=14s) */
    --sl-s2: -121px;  /* approval card + buttons       (t=30s) */
    --sl-s3: -397px;  /* rich reply                    (t=39.2s) */
    --sl-s4: -596px;  /* /usage + quota card           (t=64s)  */
    --sl-pop: cubic-bezier(0.34, 1.4, 0.64, 1); /* Telegram-ish bubble pop */
  }
  .sl-stage { height: 636px; min-height: 0; }
  .sl-viewport { position: relative; flex: 1; overflow: hidden; min-height: 0; }
  .sl-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--tg-bg);
    will-change: transform;
  }
  /* static stacking: klanker chat on top at its final frame */
  .sl-list { z-index: 1; transform: translateX(-25%); }
  .sl-k    { z-index: 4; transform: translateX(0); }
  .sl-m    { z-index: 2; transform: translateX(100%); }

  .sl-khead { position: relative; z-index: 3; }
  .sl-khead .tg-pinbar {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 3;
  }
  .sl-bodyw {
    flex: 1;
    overflow: hidden;
    min-height: 0;
    position: relative;
    background:
      radial-gradient(var(--tg-pattern) 1.5px, transparent 1.5px),
      radial-gradient(var(--tg-pattern) 1.5px, transparent 1.5px),
      var(--tg-bg);
    background-size: 28px 28px, 28px 28px;
    background-position: 0 0, 14px 14px;
  }
  .sl-scroll {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 44px 10px 16px; /* top padding clears the overlaid pin bar */
    transform: translateY(var(--sl-s4));
    will-change: transform;
  }
  .sl-list .tg-list .chat { overflow: hidden; }

  /* variant swap: stack states in one grid cell, crossfade via opacity */
  .sl-swap { display: inline-grid; }
  .sl-swap > * { grid-area: 1 / 1; min-width: 0; }
  .sl-prev { display: grid; overflow: hidden; }
  .sl-prev > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sl-time { display: inline-grid; justify-items: end; }
  .l2 .sl-prev { flex: 1; min-width: 0; }

  /* STATIC final state: everything resolved */
  .sl-swap .vA { opacity: 0; }
  .sl-swap .vB { opacity: 1; }
  .sl-r2 .vB, .sl-r3 .vB { opacity: 0; }
  .sl-r2 .vC, .sl-r3 .vC { opacity: 1; }
  .sl-pmeta .vB, .sl-pmeta .vC { opacity: 0; }
  .sl-pmeta .vD { opacity: 1; }
  .sl-bar { width: 100%; }
  .sl-badge { opacity: 0; }
  .sl-kb { overflow: hidden; max-height: 0; opacity: 0; margin-top: -3px; }
  .sl-kb .tg-kb { padding-top: 3px; }

  /* header subtitle stack (specificity must beat `.tg-head .who span`) */
  .tg-head .who span.sl-sub { display: grid; justify-items: center; }
  .sl-sub > span { grid-area: 1 / 1; display: block; font-size: 11.5px; color: var(--tg-muted); opacity: 0; }
  .sl-sub .s-bot { opacity: 1; }

  /* edit flash (Telegram's brief highlight when a message is edited) */
  .sl-flash::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    opacity: 0;
    pointer-events: none;
  }

  /* tap ripple primitive */
  .sl-ripple {
    position: absolute;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
  }
  .sl-row-k { position: relative; }
  .sl-rip-row { left: 46%; top: 8px; }
  .sl-btn-ok { position: relative; overflow: hidden; }
  .sl-rip-ok { left: calc(50% - 21px); top: calc(50% - 21px); }
  .sl-back { position: relative; }
  .sl-rip-back { left: -14px; top: -10px; }
  .sl-rip-ban { left: 20px; top: 4px; }

  /* notification banner */
  .sl-banner {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tg-header) 88%, #ffffff 12%);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transform: translateY(-130%);
    overflow: hidden;
    will-change: transform;
  }
  .sl-banner .tg-ava { width: 30px; height: 30px; font-size: 13px; }
  .sl-ban-txt { min-width: 0; font-size: 12px; line-height: 1.35; color: var(--tg-header-text); }
  .sl-ban-txt b { display: block; font-size: 12.5px; }
  .sl-ban-txt span { display: block; color: var(--tg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ════════════════════════════════════════════════════════════════════════
     MOTION — full-loop keyframes. Percent = seconds / 76 × 100.
     ════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {

    /* ── screens: push / pop transitions + loop seam ── */
    .sl-list { animation: sl-scr-list var(--sl-loop) linear infinite; }
    .sl-k    { animation: sl-scr-k    var(--sl-loop) linear infinite; }
    .sl-m    { animation: sl-scr-m    var(--sl-loop) linear infinite; }

    @keyframes sl-scr-list {
      /* on top at the seam and through scene 1 */
      0%     { transform: translateX(0);     opacity: 1; z-index: 7; }
      2%     { z-index: 3; }
      5.26%  { transform: translateX(0);     opacity: 1; animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
      5.79%  { transform: translateX(-25%); }                      /* push → klanker */
      96.4%  { z-index: 3; }                                       /* hold z flat (no tween) */
      74.87% { transform: translateX(-25%); opacity: 1; animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
      75.39% { transform: translateX(0); }                         /* pop ← marko */
      78.55% { transform: translateX(0);    animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
      79.08% { transform: translateX(-25%); }                      /* push → klanker (row tap) */
      80%    { opacity: 1; }
      81%    { opacity: 0; transform: translateX(0); }             /* reset beneath, state A restored */
      96.71% { opacity: 0; z-index: 7; }
      98.68% { opacity: 1; }                                       /* loop seam crossfade (~1.5s) */
      100%   { transform: translateX(0); opacity: 1; z-index: 7; }
    }
    @keyframes sl-scr-k {
      0%     { transform: translateX(100%); z-index: 2; }
      5.26%  { transform: translateX(100%); z-index: 4; animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
      5.79%  { transform: translateX(0); }                         /* enters over the list */
      64.74% { transform: translateX(0);    animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
      65.26% { transform: translateX(-25%); }                      /* marko pushes over */
      74.86% { z-index: 4; }
      74.87% { z-index: 2; }                                       /* drop beneath the returning list */
      78.42% { transform: translateX(-25%); z-index: 2; }
