---
// A live progress card: plain-words status while an agent works.
// Pinned to the chat — the pinned bar under the header is part of the shot.
---

<div
  class="tg-card tg"
  role="img"
  aria-label="Telegram chat with klanker showing a pinned live progress card for a delegated task, refresh the Acme landing page: repo cloned and build green are done, Lighthouse mobile pass is running, open PR for review is queued, with a progress bar underneath, updated 12 seconds ago."
>
  <div class="tg-head" aria-hidden="true">
    <span class="back">‹</span>
    <span class="who"><b>klanker</b><span>working…</span></span>
    <span class="tg-ava a4">k</span>
  </div>
  <div class="tg-pinbar" aria-hidden="true">
    <span class="pin-rail"></span>
    <span class="pin-lines">
      <span class="pin-label">📌 Pinned message</span>
      <span class="pin-preview">⚙️ worker · refresh the Acme landing page</span>
    </span>
    <span class="pin-x">✕</span>
  </div>
  <div class="tg-body" aria-hidden="true">
    <div class="msg in tail" style="max-width:100%; width:100%">
      <span class="name">klanker</span>
      <p class="card-title">⚙️ worker · refresh the Acme landing page</p>
      <div class="rows">
        <span class="row"><span class="st ok">✓</span><span>Repo cloned, branch cut</span></span>
        <span class="row"><span class="st ok">✓</span><span>Build green, zero JS shipped</span></span>
        <span class="row"><span class="st run">▸</span><span>Running Lighthouse, mobile pass</span></span>
        <span class="row"><span class="st dim">·</span><span class="dim">Open PR for review</span></span>
      </div>
      <span class="bar"><i></i></span>
      <span class="meta">updated 12s ago</span>
    </div>
  </div>
</div>
