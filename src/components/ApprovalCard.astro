---
// The Allow/Deny approval card — the leash, rendered.
---

<div
  class="tg-card tg"
  role="img"
  aria-label="Telegram approval card: marko requests read access to the vault key linkedin/api-token for one hour to schedule the launch post. Tappable Approve and Deny buttons underneath."
>
  <div class="tg-head" aria-hidden="true">
    <span class="tg-ava a2">m</span>
    <span class="who"><b>marko</b><span>bot</span></span>
    <span class="dots">⋮</span>
  </div>
  <div class="tg-body" aria-hidden="true">
    <div class="msg in" style="max-width:100%">
      <span class="name">marko</span>
      <p class="card-title">🔐 Vault access request</p>
      <p>marko wants to read <code>linkedin/api-token</code></p>
      <p><b>Scope:</b> read · expires in 1h<br />
      <b>Reason:</b> schedule the launch post you approved</p>
      <div class="tg-kb">
        <span class="kb-btn">✅ Approve</span>
        <span class="kb-btn">🚫 Deny</span>
      </div>
      <span class="meta">9:15</span>
    </div>
  </div>
</div>
